# Copy this file to .env and provide a project-scoped OpenAI API key.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4.1-mini
MAX_LLM_CALLS_PER_SESSION=20

# TypeSafe Jev handles bounded decisions; OpenAI remains responsible for voice and dialogue.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_DECISION_THRESHOLD=0.72
JEV_SAFETY_THRESHOLD=0.80
# Language choices are also validated against the words actually spoken.
JEV_LANGUAGE_THRESHOLD=0.50

# OpenAI Realtime SIP. Create the webhook secret in the OpenAI project dashboard.
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Fixed, server-owned PSTN destination for human handoff. Use E.164 format.
HUMAN_HANDOFF_NUMBER=+5511981020050
# Demo only: stores complete customer and agent speech in logs without redaction.
DEMO_LOG_FULL_TRANSCRIPTS=true
CUSTOMERS_CSV=../data/raw/customers.csv
PORT=8001

# Izzy web chat (/agent). The phone line is shown as the alternative channel.
IZZY_PHONE_NUMBER=+16615779964
IZZY_CHAT_SESSION_TTL_MINUTES=30
IZZY_CHAT_MAX_MESSAGE_CHARS=500
IZZY_CHAT_MAX_TURNS=40

# Optional LangSmith observability. Keep disabled for local/offline use.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=dispute-factored
LANGSMITH_API_KEY=

# The web app and the voice channel (SIP server and Lambda) share the PostgreSQL below and do
# not start without it. Customer data comes only from `dispute-db-seed-lakehouse` (synthetic).

# Owner role: created by the container; used only by migrations and data loaders.
POSTGRES_DB=factored
POSTGRES_USER=factored_owner
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Password for the least-privilege application role "factored_app" (set when migrating).
# Use letters and digits only so the URLs below need no escaping.
POSTGRES_APP_PASSWORD=
# URLs: replace the passwords with the two values above. Never commit real values.
DATABASE_URL_OWNER=postgresql://factored_owner:OWNER_PASSWORD@127.0.0.1:5433/factored
DATABASE_URL=postgresql://factored_app:APP_PASSWORD@127.0.0.1:5433/factored

# Read-only source of `dispute-db-seed-lakehouse`: the synthetic lakehouse on MotherDuck,
# reached through its PostgreSQL endpoint. Never commit the token.
MOTHERDUCK_TOKEN=
MOTHERDUCK_PG_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_DATABASE=lakehouse
MOTHERDUCK_SCHEMA=silver
